# Poort en adres. Achter Caddy zo laten (alleen de machine zelf).
PORT=3000
HOST=127.0.0.1

# 1 achter één reverse proxy (Caddy), 0 als de server direct aan internet hangt.
TRUST_PROXY=0

# Publiek adres, zonder slash aan het eind. Hieruit volgt de redirect-URI
# voor Microsoft: BASE_URL + /admin/callback
BASE_URL=http://localhost:3000

# Entra ID app-registratie (single tenant, platform "Web").
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Wie mag beheren: Microsoft-accounts (UPN), komma-gescheiden.
ADMIN_EMAILS=voornaam.achternaam@aqua.nl

# Tweede stap na Microsoft. Maak met: npm run wachtwoord
ADMIN_WACHTWOORD_HASH=

# Kioskcode: alleen tablets met deze code slaan scans en leads op.
# Koppelen: open op de tablet https://beurs.aqua.nl/#kiosk=<code>. Nieuwe code per beurs.
# Maak met: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
KIOSK_CODE=

# Bewaartermijn leads in dagen (privacybeleid: 28). Scans zijn anoniem en blijven.
LEAD_BEWAARDAGEN=28

DB_PATH=./data/brandrisicoscan.db
